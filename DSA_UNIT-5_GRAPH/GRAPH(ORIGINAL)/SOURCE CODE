
#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main()
{
    int n, edges;
    string book[20];
    vector<int> adj[20];

    cout << "Enter number of books: ";
    cin >> n;

    for (int i = 0; i < n; i++)
    {
        cout << "Enter book " << i + 1 << " name: ";
        cin >> book[i];
    }

    cout << "Enter number of recommendation links: ";
    cin >> edges;

    cout << "Enter book number pairs (1 to " << n << "):\n";

    for (int i = 0; i < edges; i++)
    {
        int u, v;
        cin >> u >> v;

        adj[u - 1].push_back(v - 1);
        adj[v - 1].push_back(u - 1);
    }

    cout << "\nBook Recommendations:\n";

    for (int i = 0; i < n; i++)
    {
        cout << book[i] << " recommends/links to: ";

        for (int j = 0; j < adj[i].size(); j++)
        {
            cout << book[adj[i][j]] << " ";
        }

        cout << "\nDirect recommendations: "
             << adj[i].size() << endl;
    }

    return 0;
}
